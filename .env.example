# ---------------------------------------------------------------------------
# Japan Second Trip — environment
#
# Copy to .env. Every value here has a working default: with no credentials at
# all the whole product runs on demo providers and seeded evidence, clearly
# labelled as such throughout the UI.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- database --------------------------------------------------------------
# docker compose exposes PostgreSQL on 5433 to avoid clashing with a local one.
DATABASE_URL=postgresql+asyncpg://jst:jst@localhost:5433/jst
# Tests default to a temporary SQLite file; point this at PostgreSQL to run the
# same suite against pgvector and full-text search.
# JST_TEST_DATABASE_URL=postgresql+asyncpg://jst:jst@localhost:5433/jst_test

# --- cache -----------------------------------------------------------------
# Optional. Without it the app uses a bounded in-process cache.
# REDIS_URL=redis://localhost:6380/0

# --- AI providers ----------------------------------------------------------
# demo | openai | anthropic. `demo` is deterministic, free and offline.
LLM_PROVIDER=demo
LLM_FALLBACK_PROVIDER=demo
LLM_MODEL_REASONING=claude-opus-5
LLM_MODEL_FAST=claude-haiku-4-5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# demo | openai. The demo embedder is a deterministic hashing vectoriser.
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=text-embedding-3-small
# Changing this is a database migration, not a config flip.
EMBEDDING_DIM=384

# heuristic | llm
RERANKER=heuristic

# --- external data providers ----------------------------------------------
PLACE_PROVIDER=demo          # demo | google
TRANSPORT_PROVIDER=demo      # demo | google
WEATHER_PROVIDER=demo        # demo | openmeteo  (open-meteo needs no key)
# GOOGLE_MAPS_API_KEY=

# --- retrieval -------------------------------------------------------------
# keyword | vector | hybrid | hybrid_rerank.
# `hybrid` is the measured default. Reranking is implemented but costs a case on
# a corpus this size — see docs/evals/retrieval-comparison.md before changing it.
RETRIEVAL_STRATEGY=hybrid
# Both swept, not guessed. Re-sweep after changing the embedding provider or
# growing the corpus: `python -m evals.runners.sweep`.
RRF_K=5
RETRIEVAL_DENSE_WEIGHT=0.5
RETRIEVAL_CANDIDATE_K=24
RETRIEVAL_FINAL_K=6

# --- security --------------------------------------------------------------
# Refused outright in staging/production — set a real one there.
ADMIN_TOKEN=dev-admin-token
JWT_SECRET=dev-insecure-secret-change-me
RATE_LIMIT_PER_MINUTE=60
# Comma-separated. Must be the real browser origin in a deployed environment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only these domains may ever be ingested.
INGEST_DOMAIN_ALLOWLIST=japan.travel,jnto.go.jp,jrailpass.com,go-tohoku.jp,visitkyushu.com,go-nagano.net,shikoku.gr.jp,hokuriku-w.com

# --- observability ---------------------------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- checkpointing ---------------------------------------------------------
# Persist LangGraph state to PostgreSQL so a graph paused on interrupt() can be
# resumed by another process. Falls back to an in-process saver on SQLite.
DURABLE_CHECKPOINTS=true

# --- agent limits ----------------------------------------------------------
AGENT_MAX_STEPS=24
AGENT_MAX_TOOL_CALLS=40
CONTEXT_TOKEN_BUDGET=6000

# --- pricing (configuration, not code) -------------------------------------
PRICE_WHERE_NEXT_AUD=0
PRICE_VERIFIED_ROUTE_AUD=59
PRICE_ROUTE_CHECK_AUD=129
# STRIPE_SECRET_KEY=

# --- web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
